# Octop 侧连接 WeKnora 的非敏感示例。真实 Key / 密码 / JWT 不要写进本文件。
# Octop 会把 BASE_URL 规范化为 <origin>/api/v1；这里只填 origin（不带 /api/v1、不带查询参数）。

# 二选一：公司内网入口（推荐，若 Octop 主机与 WeKnora 同网段）
OCTOP_WEKNORA_BASE_URL=http://192.168.102.104:18080
# 或：外部映射入口（不同 origin，选定后不要随意切换）
# OCTOP_WEKNORA_BASE_URL=http://sncon.k9.luyouxia.net:44813

OCTOP_WEKNORA_VERSION=0.8.3-dev.e1f9a616
OCTOP_WEKNORA_IMAGE_DIGEST=sha256:3944258a304861984ce0e94f7a33bdca33c485c6280e0e24944084d6976368cc

# 企业共享库：租户 10001，库「工作流程」（当前 0 文档，入库后补 DOCUMENT_IDS）
OCTOP_WEKNORA_TENANT_ID=10001
OCTOP_WEKNORA_TEST_KB_IDS=805b7515-6cff-4db4-978a-cad5b762a9fd
OCTOP_WEKNORA_TEST_DOCUMENT_IDS=
OCTOP_WEKNORA_PROBE_QUERY=OCTOP-ACCEPT

# 仅 HTTP 测试入口需要：必须**精确等于**上面选定的 origin，不支持通配
# OCTOP_WEKNORA_TEST_HTTP_ORIGIN=http://192.168.102.104:18080

# HTTPS + 自定义 CA 时，填 Octop 主机上的 PEM 路径
# OCTOP_WEKNORA_CA_BUNDLE=/etc/octop/certs/weknora-ca.pem

# 企业 retrieve Key 通过安全渠道配置，不要在此填明文
# OCTOP_WEKNORA_API_KEY=

# 注意：
# - 管理员 JWT 不能填进 OCTOP_WEKNORA_API_KEY；本版本开户接口不接受 API Key。
# - 以上是 Octop 的开发/诊断输入，文件存在不会自动生效；
#   正式插件连接需在 Octop 管理员插件设置中保存 URL、tenant、KB 白名单与 Key。